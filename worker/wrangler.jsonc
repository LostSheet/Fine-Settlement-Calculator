{
	// 벌금 현황판 릴레이 — 배포하면 https://live.lostark-sheet.workers.dev 가 됩니다.
	// 이름을 바꾸려면 배포 전에 "name"만 고치면 됩니다.
	"name": "live",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",

	// SQLite 백엔드 Durable Object — 무료 플랜에서 쓸 수 있는 형태입니다
	// v2: 계정·세션·방송용 토큰을 담는 Accounts 하나가 늘었습니다 (idFromName("global"))
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Room", "Handoff"] },
		{ "tag": "v2", "new_sqlite_classes": ["Accounts"] }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "ROOM", "class_name": "Room" },
			{ "name": "HANDOFF", "class_name": "Handoff" },
			{ "name": "ACCOUNTS", "class_name": "Accounts" }
		]
	}
}
