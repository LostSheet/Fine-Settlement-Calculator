     ([\uC2DC\uC791]\uACFC [\uC815\uC0B0 \uB05D\uB0B4\uAE30]\xB7[\uC911\uB2E8])\uAC00 \uAC19\uC740 \uC6B0\uC0C1\uB2E8 \uBAA8\uC11C\uB9AC\uC5D0 \uC11C\uB294 \uC870\uAC74\uC785\uB2C8\uB2E4 (\xA73.4) */
